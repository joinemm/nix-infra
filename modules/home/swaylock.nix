{
  lib,
  pkgs,
  config,
  ...
}:
let
  # runs as post hook after noctalia template generation,
  # and switches out the wallpaper path for blurred and vignetted version
  blurWallpaper = pkgs.writeShellApplication {
    name = "swaylock-blur-wallpaper";
    runtimeInputs = with pkgs; [
      coreutils
      gnused
      imagemagick
    ];
    text = ''
      config_file="$XDG_CONFIG_HOME/swaylock/config"
      image="$(sed -n 's/^image=//p' "$config_file")"
      blurred_image="$XDG_CACHE_HOME/swaylock/wallpaper.png"
      mkdir -p "$(dirname "$blurred_image")"
      # Process at quarter size; swaylock scales the blurred image to fill.
      # this is 10x faster than blurring full size image.
      magick "$image" -resize 25% -blur 0x3 -background black -vignette '0x25-10%-10%' "$blurred_image"
      sed -i "s|^image=.*|image=$blurred_image|" "$config_file"
    '';
  };
in
lib.mkMerge [
  {
    programs.swaylock = {
      enable = true;
      package = pkgs.swaylock;
    };

    # swayidle used for its events, not idling
    services.swayidle = {
      enable = true;
      events = rec {
        lock = "${pkgs.procps}/bin/pidof -q swaylock || ${lib.getExe config.programs.swaylock.package} --daemonize";
        before-sleep = lock;
      };
    };
  }
  (lib.mkIf config.programs.noctalia.enable {
    xdg.configFile."noctalia/templates/swaylock.conf".text = ''
      # Generated by Noctalia from the active wallpaper and palette.
      image={{ image }}
      scaling=fill

      indicator-idle-visible
      indicator-radius=120
      indicator-thickness=24

      inside-color=00000000
      ring-color={{ colors.primary.default.hex_stripped }}
      line-color={{ colors.on_tertiary.default.hex_stripped }}
      separator-color=00000000
      text-color={{ colors.primary.default.hex_stripped }}
      key-hl-color={{ colors.on_tertiary.default.hex_stripped }}
      bs-hl-color={{ colors.on_error.default.hex_stripped }}

      inside-ver-color=00000000
      ring-ver-color={{ colors.tertiary.default.hex_stripped }}
      text-ver-color={{ colors.tertiary.default.hex_stripped }}
      line-ver-color={{ colors.on_tertiary.default.hex_stripped }}

      inside-wrong-color=00000000
      ring-wrong-color={{ colors.error.default.hex_stripped }}
      text-wrong-color={{ colors.error.default.hex_stripped }}
      line-wrong-color={{ colors.on_tertiary.default.hex_stripped }}

      inside-clear-color=00000000
      ring-clear-color={{ colors.outline.default.hex_stripped }}
      text-clear-color={{ colors.outline.default.hex_stripped }}
      line-clear-color={{ colors.on_tertiary.default.hex_stripped }}
    '';

    programs.noctalia.settings.theme.templates.user.swaylock = {
      enabled = true;
      input_path = "$XDG_CONFIG_HOME/noctalia/templates/swaylock.conf";
      output_path = "$XDG_CONFIG_HOME/swaylock/config";
      post_hook = lib.getExe blurWallpaper;
      hook_async = false;
    };
  })
]
